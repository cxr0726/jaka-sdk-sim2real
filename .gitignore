# This repository contains only the simulation and real deployment projects.
/*
!/.gitignore
!/sim/
!/real/
# !/level-0/
# !/ref_thirdparty/
# Keep local Git metadata, environments, caches and build outputs out of snapshots.
.git/
.venv*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
build*/
install/
log/
logs/
data_log/
.DS_Store

# Personal recorded episodes; standalone sample motions remain versioned.
/real/scripts/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9]*/
